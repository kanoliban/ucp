{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careindex.dev/schemas/care/match.json",
  "title": "Care Match",
  "description": "Core capability for matching care seekers with care resources. Equivalent to UCP Checkout.",

  "type": "object",
  "required": ["id", "status", "needs"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique match session identifier."
    },
    "care_index": {
      "$ref": "../care_index.json#/$defs/response_match",
      "description": "Protocol metadata for this response."
    },
    "status": {
      "type": "string",
      "enum": ["searching", "requires_input", "matched", "connected", "expired", "cancelled"],
      "description": "Current state of the match session."
    },
    "care_seeker": {
      "$ref": "types/care_seeker.json",
      "description": "Entity seeking care."
    },
    "needs": {
      "type": "array",
      "description": "Care needs being matched.",
      "items": {"$ref": "types/care_need.json"}
    },
    "matches": {
      "type": "array",
      "description": "Matched resources for the expressed needs.",
      "items": {"$ref": "#/$defs/match_result"}
    },
    "escalation": {
      "$ref": "#/$defs/escalation",
      "description": "Human escalation details when status is requires_input."
    },
    "messages": {
      "type": "array",
      "description": "Informational, warning, or error messages.",
      "items": {"$ref": "types/message.json"}
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the match session was created."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the match session expires if not completed."
    },
    "links": {
      "type": "array",
      "description": "Related actions and resources.",
      "items": {"$ref": "types/link.json"}
    }
  },

  "$defs": {
    "match_result": {
      "type": "object",
      "description": "A matched resource for a care need.",
      "properties": {
        "need_id": {
          "type": "string",
          "description": "ID of the care need this matches."
        },
        "resource": {
          "$ref": "types/resource.json",
          "description": "The matched resource."
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Match quality score (0-1)."
        },
        "score_breakdown": {
          "type": "object",
          "description": "Components of the match score.",
          "properties": {
            "capability_match": {"type": "number"},
            "availability_match": {"type": "number"},
            "location_match": {"type": "number"},
            "budget_match": {"type": "number"},
            "quality_score": {"type": "number"}
          }
        },
        "available_windows": {
          "type": "array",
          "description": "Specific time windows when this resource can provide care.",
          "items": {
            "type": "object",
            "properties": {
              "start": {"type": "string", "format": "date-time"},
              "end": {"type": "string", "format": "date-time"}
            }
          }
        },
        "estimated_rate": {
          "type": "object",
          "description": "Estimated cost for this match.",
          "properties": {
            "amount": {"type": "number"},
            "unit": {"type": "string"},
            "currency": {"type": "string"}
          }
        },
        "connection_method": {
          "type": "string",
          "enum": ["direct", "platform_mediated", "agency_referral"],
          "description": "How to connect with this resource."
        }
      }
    },

    "escalation": {
      "type": "object",
      "description": "Human intervention required. DIVERGENCE: Care Index MUST define fallback strategy. Unlike UCP (which has PSPs as clearing house), care has no guaranteed fallback.",
      "required": ["reason", "fallback_strategy"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "no_matches",
            "budget_exceeded",
            "schedule_conflict",
            "special_requirements",
            "verification_needed",
            "consent_required",
            "version_mismatch",
            "other"
          ],
          "description": "Why escalation is needed."
        },
        "message": {
          "type": "string",
          "description": "Human-readable explanation."
        },
        "fallback_strategy": {
          "$ref": "#/$defs/fallback_strategy",
          "description": "DIVERGENCE: Mandatory fallback when no match found. UCP has PSPs; Care Index must be explicit."
        },
        "continue_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to continue the match process with human assistance."
        },
        "required_inputs": {
          "type": "array",
          "description": "Specific inputs needed to proceed.",
          "items": {
            "type": "object",
            "properties": {
              "field": {"type": "string"},
              "description": {"type": "string"},
              "required": {"type": "boolean"}
            }
          }
        }
      }
    },

    "fallback_strategy": {
      "type": "object",
      "description": "DIVERGENCE FROM UCP: Explicit no-match fallback. Care coordination cannot simply fail—families need care regardless of matching algorithm success.",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human_coordinator",
            "waitlist",
            "expand_search",
            "emergency_backup",
            "family_network",
            "agency_referral",
            "community_board"
          ],
          "description": "Primary fallback mechanism when matching fails."
        },
        "human_coordinator": {
          "type": "object",
          "description": "Route to human coordinator for manual matching.",
          "properties": {
            "coordinator_type": {
              "type": "string",
              "enum": ["platform_staff", "agency_coordinator", "family_coordinator", "can_helpdesk"]
            },
            "contact_method": {"type": "string"},
            "expected_response_time": {"type": "string"},
            "escalation_url": {"type": "string", "format": "uri"}
          }
        },
        "waitlist": {
          "type": "object",
          "description": "Add to waitlist and notify when resources become available.",
          "properties": {
            "position": {"type": "integer"},
            "estimated_wait": {"type": "string"},
            "notification_preferences": {
              "type": "array",
              "items": {"type": "string", "enum": ["sms", "email", "push", "in_app"]}
            }
          }
        },
        "expand_search": {
          "type": "object",
          "description": "Suggest relaxing constraints to find matches.",
          "properties": {
            "suggestions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "constraint": {"type": "string"},
                  "current_value": {"type": "string"},
                  "suggested_value": {"type": "string"},
                  "matches_if_relaxed": {"type": "integer"}
                }
              }
            }
          }
        },
        "emergency_backup": {
          "type": "object",
          "description": "Emergency backup pool for urgent needs.",
          "properties": {
            "available": {"type": "boolean"},
            "backup_pool_size": {"type": "integer"},
            "average_response_time": {"type": "string"},
            "activate_url": {"type": "string", "format": "uri"}
          }
        },
        "family_network": {
          "type": "object",
          "description": "Fall back to existing family care network.",
          "properties": {
            "network_members_available": {"type": "integer"},
            "coverage_possible": {"type": "boolean"},
            "gap_remains": {"type": "string"}
          }
        },
        "message": {
          "type": "string",
          "description": "Human-readable explanation of fallback options."
        },
        "next_steps": {
          "type": "array",
          "description": "Ordered list of recommended next steps.",
          "items": {"type": "string"}
        }
      }
    }
  }
}
